# ──────────────────────────────────────────────────────────
# KissanAI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ──────────────────────
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── Redis (Redis Cloud / Upstash) ─────────────────────────
REDIS_HOST=your-redis-host.redis.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# ── Image Storage (Cloudinary) ────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── External APIs ─────────────────────────────────────────
OPENWEATHERMAP_KEY=your-openweathermap-api-key
GEMINI_API_KEY=your-gemini-api-key

# ── JWT Configuration ─────────────────────────────────────
SECRET_KEY=your-jwt-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. https://your-frontend.com)
# Leave empty for development wildcard (*)
ALLOWED_ORIGINS=

# ── Deployment ────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
