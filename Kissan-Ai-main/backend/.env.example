# Database - Supabase (PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Redis - Redis Cloud (redis.io)
REDIS_HOST=<your_redis_cloud_host>
REDIS_PORT=6379
REDIS_USERNAME=<your_redis_username>
REDIS_PASSWORD=<your_redis_password>

# Image storage - pick ONE:

# Option A: Cloudinary
CLOUDINARY_URL=<cloudinary_url>

# Option B: Cloudflare R2
# R2_ACCESS_KEY=your_r2_access_key
# R2_SECRET_KEY=your_r2_secret_key
# R2_BUCKET=your_r2_bucket
# R2_ENDPOINT=your_r2_endpoint

# External APIs
OPENWEATHERMAP_KEY=your_openweathermap_key
GEMINI_API_KEY=your_gemini_api_key

# JWT Configuration
# Generate with: openssl rand -hex 32 — never use a default value
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated frontend origins (leave empty or omit for dev wildcard)
# Example: ALLOWED_ORIGINS=https://app.kissanai.com,http://localhost:3000
ALLOWED_ORIGINS=
